flowchart LR
  subgraph S["Sender-controlled endpoint"]
    S1["Plaintext"]
    S2["Identity and private keys"]
    S3["Authenticated message protection"]
    S1 --> S3
    S2 --> S3
  end

  subgraph U["Untrusted transport domain"]
    C["Coordinator / bot"]
    P["Messaging platform"]
    I["Image host / storage"]
    C <--> P
    P <--> I
  end

  subgraph R["Recipient-controlled endpoint"]
    R1["Peer identity verification"]
    R2["Capsule validation"]
    R3["Authenticated decryption"]
    R4["Plaintext"]
    R1 --> R3
    R2 --> R3
    R3 --> R4
  end

  S3 -->|"Protected capsule(s)"| C
  I -->|"Carrier object(s)"| R2

  classDef endpoint fill:#dcefe5,stroke:#28734a,color:#123d28
  classDef untrusted fill:#f8e8d6,stroke:#a65d16,color:#60330b
  class S1,S2,S3,R1,R2,R3,R4 endpoint
  class C,P,I untrusted
